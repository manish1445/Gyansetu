# Required: Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq text/tool-calling model (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Groq vision model used when an image is attached (defaults to meta-llama/llama-4-scout-17b-16e-instruct)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: Teacher login passcode (defaults to teacher123)
TEACHER_PASSCODE=teacher123

# Optional: Server port (defaults to 3000)
PORT=3000

# Optional: SQLite database path (defaults to ./data/gyansetu.db)
DB_PATH=./data/gyansetu.db
