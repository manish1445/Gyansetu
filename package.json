{
  "name": "gyansetu",
  "version": "1.0.0",
  "description": "GyanSetu — Autonomous AI Tutor for College Students in India powered by Groq API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
